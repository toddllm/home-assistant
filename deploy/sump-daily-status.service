[Unit]
Description=Sump system daily status digest (primary -> operator)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=tdeshane
WorkingDirectory=/home/tdeshane/home-assistant
ExecStart=/usr/bin/python3 -u /home/tdeshane/home-assistant/sump_daily_status.py
StandardOutput=append:/home/tdeshane/home-assistant/sump_daily_status.log
StandardError=append:/home/tdeshane/home-assistant/sump_daily_status.log
